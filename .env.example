# SentinelAI Configuration

# Network capture
CAPTURE_INTERFACE=en0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_ai
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme

# Detection thresholds live in config/detection.toml.
# Uncomment to override the alert cooldown (seconds) from that file.
# ALERT_COOLDOWN_SECONDS=60

# Optional: learn hostnames (DNS, HTTP Host, TLS SNI) for alert context
# (privacy trade-off).
# Also set enabled = true under [names] in config/detection.toml, then
# restart capture and the analyzer.
# PAYLOAD_INSPECTION=false

# Dashboard
DASHBOARD_PORT=8000
DASHBOARD_UI_PORT=3001

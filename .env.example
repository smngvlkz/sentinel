# SentinelAI Configuration

# Network capture
CAPTURE_INTERFACE=en0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_ai
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme

# Detection thresholds live in config/detection.toml.
# Uncomment to override the alert cooldown (seconds) from that file.
# ALERT_COOLDOWN_SECONDS=60

# Optional: learn hostnames (DNS, HTTP Host, TLS SNI) for alert context
# (privacy trade-off).
# Also set enabled = true under [names] in config/detection.toml, then
# restart capture and the analyzer.
# PAYLOAD_INSPECTION=false

# Known botnet servers ([known_servers] in config/detection.toml): the list
# is downloaded from abuse.ch's ThreatFox with a free Auth-Key. Get one at
# https://auth.abuse.ch/ (treat it like a password). Without it the rule
# can't download the list and stays quiet.
# THREATFOX_AUTH_KEY=

# Dashboard
DASHBOARD_PORT=8000
DASHBOARD_UI_PORT=3001
# Who can open the dashboard. 127.0.0.1: this machine only. 0.0.0.0: other
# devices too (your Wi-Fi, or anywhere over Tailscale). That needs a password
# first: run make password, or the dashboard won't start.
# DASHBOARD_BIND=0.0.0.0

# Notifications. Settings are in config/notifications.toml; only secrets and
# addresses go here. make notify-setup fills in the ntfy ones.
# Your own ntfy server: COMPOSE_PROFILES=ntfy starts it with make up.
# COMPOSE_PROFILES=ntfy
# Anyone who knows the topic can read your alerts: keep it random.
# NTFY_TOPIC=
# This machine's address as your phone reaches it, e.g. over Tailscale.
# NTFY_BASE_URL=http://100.101.102.103:8090
# NTFY_PORT=8090
# What the notifier posts with. The ntfy server make up starts accepts posts
# only with this token; for another server, its access token if it needs one.
# NTFY_TOKEN=
# SMTP_PASSWORD=
# The full webhook URL (Discord, Slack, Telegram bot API, or anything else).
# It contains a secret token, so treat it like a password.
# WEBHOOK_URL=

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Install with `make install-launchd`, which fills in
  __SENTINEL_DIR__ and __CAPTURE_INTERFACE__ from your checkout and .env.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sentinelai.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>__SENTINEL_DIR__/.venv/bin/python</string>
        <string>__SENTINEL_DIR__/capture_service/capture.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CAPTURE_INTERFACE</key>
        <string>__CAPTURE_INTERFACE__</string>
        <key>REDIS_HOST</key>
        <string>localhost</string>
        <key>REDIS_PORT</key>
        <string>6379</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__SENTINEL_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__SENTINEL_DIR__/logs/capture.log</string>

    <key>StandardErrorPath</key>
    <string>__SENTINEL_DIR__/logs/capture.error.log</string>
</dict>
</plist>

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# Only what capture imports: the rest (numpy, scikit-learn, the API) is for
# the other services and would make this image several times bigger.
RUN pip install --no-cache-dir $(grep -E '^(scapy|pcapy-ng|redis|python-dotenv)==' requirements.txt)

COPY capture_service/ ./capture_service/
COPY common/ ./common/

CMD ["python", "capture_service/capture.py"]

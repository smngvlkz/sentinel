FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY analysis_service/ ./analysis_service/
COPY common/ ./common/
COPY database/migrations/ ./database/migrations/
COPY detection_engine/ ./detection_engine/
COPY alert_service/ ./alert_service/
COPY config/ ./config/
COPY scripts/simulate_attack.py ./scripts/
# The trained model (if any) is mounted from the host by docker-compose,
# so retraining only needs a restart, not a rebuild.
RUN mkdir -p ml-models/saved

CMD ["python", "analysis_service/analyzer.py"]
